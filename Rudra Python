        "# SMART CAR PARKING ASSIST SYSTEM\n",
        "# Fuzzy Logic Based Warning System\n",
        "\n",
        "# Triangular membership function\n",
        "def trimf(x, a, b, c):\n",
        "    if x <= a or x >= c:\n",
        "        if x == b:\n",
        "            return 1\n",
        "        return 0\n",
        "\n",
        "    if x == b:\n",
        "        return 1\n",
        "\n",
        "    if x < b:\n",
        "        return (x - a) / (b - a)\n",
        "\n",
        "    return (c - x) / (c - b)\n",
        "\n",
        "\n",
        "# Input values\n",
        "distance = 25\n",
        "speed = 40\n",
        "\n",
        "\n",
        "# -----------------------------\n",
        "# DISTANCE MEMBERSHIP\n",
        "# -----------------------------\n",
        "\n",
        "near = trimf(distance, 0, 0, 30)\n",
        "medium = trimf(distance, 15, 50, 85)\n",
        "far = trimf(distance, 70, 150, 150)\n",
        "\n",
        "\n",
        "# -----------------------------\n",
        "# SPEED MEMBERSHIP\n",
        "# -----------------------------\n",
        "\n",
        "slow = trimf(speed, 0, 0, 20)\n",
        "moderate = trimf(speed, 10, 50, 90)\n",
        "fast = trimf(speed, 70, 150, 150)\n",
        "\n",
        "\n",
        "# -----------------------------\n",
        "# FUZZY RULES\n",
        "# -----------------------------\n",
        "\n",
        "rules = []\n",
        "\n",
        "# Near\n",
        "rules.append((min(near, slow), \"warning\"))\n",
        "rules.append((min(near, moderate), \"warning\"))\n",
        "rules.append((min(near, fast), \"stop\"))\n",
        "\n",
        "# Medium\n",
        "rules.append((min(medium, slow), \"caution\"))\n",
        "rules.append((min(medium, moderate), \"caution\"))\n",
        "rules.append((min(medium, fast), \"warning\"))\n",
        "\n",
        "# Far\n",
        "rules.append((min(far, slow), \"safe\"))\n",
        "rules.append((min(far, moderate), \"safe\"))\n",
        "rules.append((min(far, fast), \"caution\"))\n",
        "\n",
        "\n",
        "# -----------------------------\n",
        "# OUTPUT MEMBERSHIP FUNCTIONS\n",
        "# -----------------------------\n",
        "\n",
        "def safe(x):\n",
        "    return trimf(x, 0, 0, 25)\n",
        "\n",
        "def caution(x):\n",
        "    return trimf(x, 15, 35, 55)\n",
        "\n",
        "def warning(x):\n",
        "    return trimf(x, 45, 65, 85)\n",
        "\n",
        "def stop(x):\n",
        "    return trimf(x, 75, 100, 100)\n",
        "\n",
        "\n",
        "# -----------------------------\n",
        "# MAMDANI DEFUZZIFICATION\n",
        "# Centroid Method\n",
        "# -----------------------------\n",
        "\n",
        "numerator = 0\n",
        "denominator = 0\n",
        "\n",
        "for x in range(101):\n",
        "\n",
        "    output_value = 0\n",
        "\n",
        "    for strength, output_type in rules:\n",
        "\n",
        "        if output_type == \"safe\":\n",
        "            value = min(strength, safe(x))\n",
        "\n",
        "        elif output_type == \"caution\":\n",
        "            value = min(strength, caution(x))\n",
        "\n",
        "        elif output_type == \"warning\":\n",
        "            value = min(strength, warning(x))\n",
        "\n",
        "        else:\n",
        "            value = min(strength, stop(x))\n",
        "\n",
        "        output_value = max(output_value, value)\n",
        "\n",
        "    numerator += x * output_value\n",
        "    denominator += output_value\n",
        "\n",
        "\n",
        "warning_level = numerator / denominator\n",
        "\n",
        "\n",
        "# -----------------------------\n",
        "# DISPLAY RESULT\n",
        "# -----------------------------\n",
        "\n",
        "print(\"=\" * 55)\n",
        "print(\"       SMART CAR PARKING ASSIST SYSTEM\")\n",
        "print(\"       FUZZY LOGIC CONTROLLER\")\n",
        "print(\"=\" * 55)\n",
        "\n",
        "print(\"Distance       :\", format(distance, \".2f\"), \"cm\")\n",
        "print(\"Approach Speed :\", format(speed, \".2f\"), \"cm/s\")\n",
        "print(\"Warning Level  :\", format(warning_level, \".2f\"), \"%\")\n",
        "\n",
        "\n",
        "# -----------------------------\n",
        "# WARNING MESSAGE\n",
        "# -----------------------------\n",
        "\n",
        "if warning_level < 25:\n",
        "    message = \"SAFE - No immediate danger.\"\n",
        "\n",
        "elif warning_level < 45:\n",
        "    message = \"CAUTION - Obstacle is approaching.\"\n",
        "\n",
        "elif warning_level < 75:\n",
        "    message = \"WARNING - Reduce vehicle speed.\"\n",
        "\n",
        "else:\n",
        "    message = \"STOP - Obstacle is very close!\"\n",
        "\n",
        "\n",
        "print(\"Status         :\", message)\n",
        "print(\"=\" * 55)"
      ]
